@page "/"
@using Microsoft.AspNetCore.Authorization
<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1> Hello, @context.User.Identity?.Name! </h1> <br />
        You are authenticated.
    </Authorized>
    <NotAuthorized>
        <h1>Hello, world!</h1>
    </NotAuthorized>
</AuthorizeView>

<br />
 Welcome to your new app.

